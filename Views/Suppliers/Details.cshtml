@model Joo_Jeana_HW5.Models.Supplier

@{
    ViewData["Title"] = "Supplier Details";
}

<h1>Details</h1>

<div>
    <h4>Supplier</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.SupplierName)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.SupplierName)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Email)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Email)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.PhoneNumber)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.PhoneNumber)
        </dd>
    </dl>
</div>

<hr />
<h5>Products provided by this Supplier</h5>

@if (Model.Products != null && Model.Products.Any())
{
    <table class="table table-hover table-sm table-striped" style="max-width: 500px;">
        <thead class="table-dark">
            <tr>
                <th>Product Name</th>
            </tr>
        </thead>
        <tbody>
            @foreach (Product product in Model.Products)
            {
                <tr>
                    <td>@product.Name</td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p>No products listed for this supplier.</p>
}

<div class="mt-4">
    <a asp-action="Edit" asp-route-id="@Model?.SupplierID" class="btn btn-warning">Edit</a> |
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</div>