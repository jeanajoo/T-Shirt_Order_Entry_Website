@model Joo_Jeana_HW5.Models.Supplier

@{
    ViewData["Title"] = "Create Supplier";
}

<h1>Create</h1>

<h4>Supplier</h4>
<hr />
<div class="row">
    <div class="col-md-6"> 
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group mb-3">
                <label asp-for="SupplierName" class="control-label fw-bold"></label>
                <input asp-for="SupplierName" class="form-control" placeholder="e.g. Acme Corp" />
                <span asp-validation-for="SupplierName" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Email" class="control-label fw-bold"></label>
                <input asp-for="Email" class="form-control" placeholder="supplier@example.com" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="PhoneNumber" class="control-label fw-bold"></label>
                <input asp-for="PhoneNumber" class="form-control" placeholder="512-555-0199" />
                <span asp-validation-for="PhoneNumber" class="text-danger"></span>
            </div>

            <div class="form-group mt-4">
                <input type="submit" value="Create Supplier" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary">Back to List</a>
            </div>
        </form>
    </div>
</div>