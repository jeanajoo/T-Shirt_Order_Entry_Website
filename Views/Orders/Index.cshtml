@model IEnumerable<Joo_Jeana_HW5.Models.Order>

@{
    ViewData["Title"] = "Order History";
}

<h2>Order History</h2>

@if (User.IsInRole("Customer"))
{
    <p>
        <a asp-action="Create" class="btn btn-primary">Create New Order</a>
    </p>
}

<table class="table table-hover">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.OrderNumber)
            </th>
            @if (User.IsInRole("Admin"))
            {
                <th>Customer</th>
            }
            <th>
                @Html.DisplayNameFor(model => model.OrderDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.OrderNotes)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.OrderTotal)
            </th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.OrderNumber)
                </td>
                @if (User.IsInRole("Admin"))
                {
                    <td>
                        @Html.DisplayFor(modelItem => item.User.Email)
                    </td>
                }
                <td>
                    @Html.DisplayFor(modelItem => item.OrderDate)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.OrderNotes)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.OrderTotal)
                </td>
                <td>
                    @if (User.IsInRole("Customer"))
                    {
                        <a asp-action="Edit" asp-route-id="@item.OrderID">Edit</a> <text>|</text>
                    }
                    
                    <a asp-action="Details" asp-route-id="@item.OrderID">Details</a>
                    
                    @if (User.IsInRole("Admin"))
                    {
                        <text>|</text> <a asp-action="Delete" asp-route-id="@item.OrderID">Delete</a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>