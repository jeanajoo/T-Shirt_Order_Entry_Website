@model Joo_Jeana_HW5.Models.Order

@{
    ViewData["Title"] = "Edit Order Notes";
}

<h2>Edit Order</h2>
<hr />
<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <input type="hidden" asp-for="OrderID" />

            <div class="form-group mb-3">
                <label asp-for="OrderNumber" class="control-label fw-bold"></label>
                <div>@Html.DisplayFor(model => model.OrderNumber)</div>
            </div>

            <div class="form-group mb-3">
                <label asp-for="OrderDate" class="control-label fw-bold"></label>
                <div>@Html.DisplayFor(model => model.OrderDate)</div>
            </div>

            <div class="form-group mb-3">
                <label asp-for="OrderNotes" class="control-label fw-bold"></label>
                @* This is the only field the user can actually change *@
                <textarea asp-for="OrderNotes" class="form-control"></textarea>
                <span asp-validation-for="OrderNotes" class="text-danger"></span>
            </div>

            <div class="form-group mt-3">
                <input type="submit" value="Save Changes" class="btn btn-success" />
                <a asp-action="Index" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

<h5 class="mt-4">Items in this Order</h5>
<table class="table table-striped mt-2">
    <thead class="table-dark">
        <tr>
            <th>Product</th>
            <th>Price</th>
            <th>Quantity</th>
            <th>Extended Price</th>
        </tr>
    </thead>
    <tbody>
        @foreach (OrderDetail od in Model.OrderDetails)
        {
            <tr>
                <td>@Html.DisplayFor(m => od.Product.Name)</td>
                <td>@Html.DisplayFor(m => od.ProductPrice)</td>
                <td>@Html.DisplayFor(m => od.Quantity)</td>
                <td>@Html.DisplayFor(m => od.ExtendedPrice)</td>
            </tr>
        }
    </tbody>
</table>

<div class="mt-3">
    <a asp-action="Create" asp-controller="OrderDetails" asp-route-orderID="@Model.OrderID" class="btn btn-primary">Add Another Item</a>
    <a asp-action="Index" asp-controller="OrderDetails" asp-route-orderID="@Model.OrderID" class="btn btn-outline-primary">Edit/Delete Items</a>
</div>