@model Joo_Jeana_HW5.Models.Order

@{
    ViewData["Title"] = "Order Details";
}

<h2>Order Details</h2>

<div>
    <h4>Order #@Model.OrderNumber</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.User.Email)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.User.Email)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.OrderDate)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.OrderDate)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.OrderNotes)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.OrderNotes)</dd>
    </dl>
</div>

<h3>Order Items</h3>
<table class="table table-sm table-striped">
    <thead>
        <tr>
            <th>Product Name</th>
            <th>Price</th>
            <th>Quantity</th>
            <th>Extended Price</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.OrderDetails != null && Model.OrderDetails.Any())
        {
            @foreach (var item in Model.OrderDetails)
            {
                <tr>
                    <td>@item.Product.Name</td>
                    <td>@Html.DisplayFor(modelItem => item.ProductPrice)</td>
                    <td>@Html.DisplayFor(modelItem => item.Quantity)</td>
                    <td>@Html.DisplayFor(modelItem => item.ExtendedPrice)</td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="4" class="text-center">No items in this order yet.</td>
            </tr>
        }
    </tbody>
</table>

<div class="mb-3">
    <a asp-action="Create" asp-controller="OrderDetails" asp-route-orderID="@Model.OrderID" class="btn btn-primary">Add Product</a>
</div>

<div class="row">
    <div class="col-md-6">
        <h3>Order Summary</h3>
        <dl class="row">
            <dt class="col-sm-4">@Html.DisplayNameFor(model => model.OrderSubtotal)</dt>
            <dd class="col-sm-8">@Html.DisplayFor(model => model.OrderSubtotal)</dd>

            <dt class="col-sm-4">@Html.DisplayNameFor(model => model.SalesTax)</dt>
            <dd class="col-sm-8">@Html.DisplayFor(model => model.SalesTax)</dd>

            <dt class="col-sm-4">@Html.DisplayNameFor(model => model.OrderTotal)</dt>
            <dd class="col-sm-8"><strong>@Html.DisplayFor(model => model.OrderTotal)</strong></dd>
        </dl>
    </div>
</div>

<hr />
<div>
    @if (User.IsInRole("Customer"))
    {
        <a asp-action="Edit" asp-route-id="@Model.OrderID" class="btn btn-warning">Edit Notes</a> <text>|</text>
    }
    <a asp-action="Index">Back to List</a>
</div>